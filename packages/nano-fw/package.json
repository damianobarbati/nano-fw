{
  "name": "nano-fw",
  "version": "2.0.9",
  "description": "Nano sized framework.",
  "license": "MIT",
  "author": "Damiano Barbati <damiano.barbati@gmail.com> (https://github.com/damianobarbati)",
  "repository": "https://github.com/damianobarbati/nano-fw",
  "type": "module",
  "engines": {
    "node": ">=26.0"
  },
  "bin": {
    "nano-fw": "./bin/nano-fw.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/database/index.d.ts",
      "import": "./dist/database/index.js"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@scalar/hono-api-reference": "^0.12.24",
    "debug": "^4.4.3",
    "find-up": "^8.0.0",
    "hono": "^4.13.21",
    "knex": "3.3.0",
    "openapi3-ts": "^4.6.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/docs/docs.html dist/docs/",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "pnpm run build && cp ../../README.md README.md"
  },
  "homepage": "https://damianobarbati.github.io/nano-fw/"
}
