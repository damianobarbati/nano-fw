{
  "name": "nano-fw-monorepo",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0"
  },
  "workspaces": [
    "packages/nano-fw",
    "packages/example"
  ],
  "scripts": {
    "prepare": "npm audit --audit-level critical",
    "oxlint": "oxlint --fix",
    "biome": "biome check --write --unsafe",
    "tsc": "tsc",
    "lint": "npm run oxlint && npm run biome && npm run tsc",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspace=nano-fw",
    "release": "npm publish --workspace=nano-fw"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.93.0",
    "oxlint-better": "1.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
