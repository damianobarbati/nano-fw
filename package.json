{
  "name": "nano-fw-monorepo",
  "version": "2.0.7",
  "description": "Nano sized framework.",
  "license": "MIT",
  "author": "Damiano Barbati <damiano.barbati@gmail.com> (https://github.com/damianobarbati)",
  "repository": "https://github.com/damianobarbati/nano-fw",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0"
  },
  "scripts": {
    "prepare": "pnpm audit --audit-level critical",
    "lint": "oxlint && biome check && tsc --noEmit",
    "test": "pnpm -r run test",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter nano-fw run build && pnpm --filter website run build",
    "release": "pnpm --filter nano-fw publish --no-git-checks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.93.0",
    "oxlint-better": "1.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.23.0",
  "homepage": "https://damianobarbati.github.io/nano-fw/"
}
