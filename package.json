{
  "name": "nano-fw",
  "version": "1.2.3",
  "description": "Nano sized framework.",
  "license": "MIT",
  "author": "Damiano Barbati <damiano.barbati@gmail.com> (https://github.com/damianobarbati)",
  "repository": "https://github.com/damianobarbati/nano-fw",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "pnpm": ">=12.4",
    "node": ">=24.7"
  },
  "files": [
    "src",
    "!src/**/*.spec.ts"
  ],
  "imports": {
    "#framework/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "prepare": "pnpm audit --audit-level critical",
    "lint": "biome check --write",
    "tsc": "tsc",
    "test": "vitest run",
    "example": "node --watch ./example/src/index.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.18",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "find-up": "^8.0.0",
    "hono": "^4.13.17",
    "knex": "3.3.0",
    "openapi3-ts": "^4.6.2",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "envk": "^4.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
