{
  "name": "fwxs",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "pnpm": ">=11.22",
    "node": ">=26.7"
  },
  "imports": {
    "#framework/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "prepare": "pnpm audit --audit-level critical",
    "lint": "biome check --write",
    "tsc": "tsc",
    "test": "vitest run",
    "env:up": "docker compose up -d --wait --quiet-pull --remove-orphans",
    "env:down": "docker compose down --volumes --remove-orphans"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/node-server": "^2.1.1",
    "dayjs": "^1.11.21",
    "debug": "^4.4.3",
    "find-up": "^8.0.0",
    "hono": "^4.13.2",
    "knex": "3.3.0",
    "pg": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "envk": "^4.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "@faker-js/faker": "^10.6.0",
    "@types/pg": "^8.20.3",
    "vitest": "^4.1.10"
  }
}
